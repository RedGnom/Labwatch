# ⚠️ ЕДИНСТВЕННАЯ СТРОКА, которую меняем при переезде на разные устройства.
#   Локальная разработка:  http://localhost:8000
#   Разные устройства:     http://192.168.1.10:8000  (IP серверного ноута)
LABWATCH_URL=http://localhost:8000

# Идентификатор узла (по ТЗ — минимум 3 узла)
NODE_ID=node-01

# Токен, которым узлы аутентифицируются на сервере.
# Должен совпадать с LABWATCH_TOKEN в node/.env.
# Для продакшена: сгенерировать случайную строку, например `openssl rand -hex 32`.
NODE_TOKEN=dev-node-token-please-change
# Токен узла для аутентификации на сервере.
# Должен совпадать с NODE_TOKEN в server/.env.
LABWATCH_TOKEN=dev-node-token-please-change